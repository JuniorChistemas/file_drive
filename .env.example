# Google Drive API
GOOGLE_CREDENTIALS_PATH=/app/credentials/google-service-account.json
DRIVE_ROOT_FOLDER=CARPETA_PRUEBA
# Nombre real de la manzana en Drive (ej. 'Manzana A')
DRIVE_MANZANA_FOLDER=Manzana A

# ERP
# URL base de la API (ej. https://erp.ejemplo.com)
ERP_API_URL=
ERP_API_KEY=
ERP_USERNAME=
ERP_PASSWORD=

# Logging
LOG_LEVEL=INFO

# Pipeline
# Reanudar desde un lote dado (inclusive); vacío = procesar todos.
# Usar tras una corrida interrumpida para no duplicar lot_assignments ya subidos.
# PIPELINE_START_FROM_LOTE=E-45
PIPELINE_START_FROM_LOTE=
